# Reverse proxy for WebApp Production, Beta, and phpMyAdmin.
# Install Caddy on the host, then copy this file to your Caddy config and reload Caddy.
# SSL certificates are obtained and renewed automatically by Caddy (Let's Encrypt).
# Custom 5xx error pages: /var/www/html/errors/error.html (served via handle_errors snippet below).

(error_pages) {
	handle_errors {
		@5xx expression {http.error.status_code} >= 500 && {http.error.status_code} < 600
		rewrite @5xx /error.html
		root * /var/www/html/errors
		templates
		file_server
	}
}

app.josh.me.uk, app.jb-vpn.uk {
	import error_pages
	reverse_proxy 127.0.0.1:8008
}

app-beta.josh.me.uk {
	import error_pages
	reverse_proxy 127.0.0.1:8009
}

# GitHub webhook auto-deploy (beta + production; branch selects env)
# DNS: hooks.josh.me.uk A → this VPS. Payload ref maps beta→beta stack, main→production.
hooks.josh.me.uk {
	handle /github-deploy {
		reverse_proxy 127.0.0.1:9010
	}
	handle /health {
		reverse_proxy 127.0.0.1:9010
	}
	handle {
		respond "Not Found" 404
	}
}

app-db.josh.me.uk {
	import error_pages
	reverse_proxy 127.0.0.1:8080
	# Restrict phpMyAdmin access (uncomment and set user/password):
	# basicauth /* {
	#   admin $2a$14$...  # caddy hash-password
	# }
}

# dsm.jb-vpn.uk – reverse proxy to Synology DSM (HTTPS, internal VPN)
dsm.jb-vpn.uk {
	import error_pages
	reverse_proxy https://10.8.0.2:5001 {
		transport http {
			tls_insecure_skip_verify
		}
		header_up Host {host}
		header_up X-Real-IP {remote}
		header_up X-Forwarded-For {remote}
		header_up X-Forwarded-Proto {scheme}
		header_up Upgrade {http.request.header.Upgrade}
		header_up Connection {http.request.header.Connection}
	}
}

# plex.jb-vpn.uk – reverse proxy to Plex on Synology
# Do NOT set X-Plex-Token (or other X-Plex-*) via header_up — empty values break auth.
plex.jb-vpn.uk {
	import error_pages
	reverse_proxy http://10.8.0.2:32400 {
		transport http {
			dial_timeout 15s
			response_header_timeout 60s
			read_timeout 300s
			write_timeout 300s
		}
		flush_interval -1
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Port {server_port}
		header_up Upgrade {http.request.header.Upgrade}
		header_up Connection {http.request.header.Connection}
		header_down Location http://10.8.0.2:32400 https://plex.jb-vpn.uk
		header_down Location https://10.8.0.2:32400 https://plex.jb-vpn.uk
		header_down Location http://192.168.1.21:32400 https://plex.jb-vpn.uk
		header_down Location https://192.168.1.21:32400 https://plex.jb-vpn.uk
		header_down Location http://strawberrynas:32400 https://plex.jb-vpn.uk
		header_down Location https://strawberrynas:32400 https://plex.jb-vpn.uk
	}
}

# vps.jb-vpn.uk – static files from /var/www/html
vps.jb-vpn.uk {
	root * /var/www/html
	file_server
}

